# /etc/fail2ban/jail.local

[DEFAULT]
# "ignoreip" can be a list of IP addresses, CIDR masks or DNS hosts.
# The client IP is ignored if it matches any value in this list.
#
# ignoreip = 127.0.0.1/8 ::1
ignoreip = 127.0.0.1/8 ::1 192.168.0.0/16

[sshd]
enabled = false

[sshd-non-lan]
enabled     = true
backend     = systemd
filter      = sshd
maxretry    = 5
findtime    = 600
bantime     = 86400
# 開啟封鎖時間增長功能
bantime.increment = true
# 封鎖時間成長倍率 (預設是 1, 2, 4, 8...)
bantime.factor = 2
# 最大封鎖時間 (例如封鎖一個月)
bantime.maxtime = 2592000
# port        = 222
journalmatch = _SYSTEMD_UNIT=ssh.service
